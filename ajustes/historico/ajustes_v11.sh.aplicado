#!/bin/bash
# Ajustes aplicados no boot (chamado pelo /boot/firstboot.sh, como root).
# Aplica, em ordem, as versoes que ainda nao rodaram. Log: /boot/ajustes_log.txt
# v1-v9 (ja aplicadas): LED, controles, hora, ES, save no power, desempenho, audio
# v10: icone do Wi-Fi nao reinicia o ES com jogo aberto + diagnostico do Wi-Fi
# v11: Wi-Fi conectava pela p2p0 (Wi-Fi Direct) e travava sem IP; rk915 nao suporta PMF
VER=11
DONE=/boot/ajustes.done
LOG=/boot/ajustes_log.txt
VOL_INICIAL=201     # ~ -20 dB: baixo mas audivel (85% na escala crua)
CUR="$(cat "$DONE" 2>/dev/null)"; CUR=${CUR:-0}
# todo boot, antes do EmulationStation abrir: saida e volume inicial
amixer -q sset 'Playback Path' SPK_HP 2>/dev/null
amixer -q sset 'Playback' $VOL_INICIAL 2>/dev/null
# todo boot: diagnostico do Wi-Fi 60 s depois (grava /boot/wifi_log.txt)
[ -x /usr/local/bin/wifi-diag.sh ] && systemd-run --on-active=60 --unit=wifi-diag-$$ /usr/local/bin/wifi-diag.sh >/dev/null 2>&1
[ "$CUR" -ge "$VER" ] && exit 0

BK=/opt/ajustes-backup/$(date +%Y%m%d-%H%M%S)
mkdir -p "$BK"
exec >>"$LOG" 2>&1
echo "==== ajustes v$((CUR+1))..v$VER  $(date)  console=$(cat /boot/.console 2>/dev/null) ===="
bk()   { [ -e "$1" ] && mkdir -p "$BK$(dirname "$1")" && cp -a "$1" "$BK$1" && echo "  backup: $1"; }
ok()   { echo "OK   $*"; }

echo "[1] Wi-Fi: redes presas na p2p0 -> wlan0; PMF desligado (rk915 nao suporta a cifra 0xFAC06)"
NMC=/etc/NetworkManager/system-connections
for f in "$NMC"/*.nmconnection; do bk "$f"; done
python3 - "$NMC" <<'PY'
import os, re, sys
d = sys.argv[1]
for f in sorted(os.listdir(d)):
    if not f.endswith(".nmconnection"): continue
    p = os.path.join(d, f)
    s = open(p, newline="").read()
    if not re.search(r"^type=wifi$", s, re.M):
        continue
    s = re.sub(r"^interface-name=.*$", "interface-name=wlan0", s, flags=re.M)
    if not re.search(r"^interface-name=", s, re.M):
        s = s.replace("[connection]\n", "[connection]\ninterface-name=wlan0\n", 1)
    if re.search(r"^pmf=", s, re.M):
        s = re.sub(r"^pmf=.*$", "pmf=1", s, flags=re.M)
    elif "[wifi-security]\n" in s:
        s = s.replace("[wifi-security]\n", "[wifi-security]\npmf=1\n", 1)
    open(p, "w", newline="").write(s)
    print("  ok:", f, "| interface wlan0, pmf desligado")
PY
chmod 600 "$NMC"/*.nmconnection

echo "[2] NetworkManager: ignora a p2p0 e desliga a economia de energia do Wi-Fi"
cat > /etc/NetworkManager/conf.d/99-k36s-wifi.conf <<'EOS'
# K36S (rk915): a p2p0 e a interface de Wi-Fi Direct; conectar por ela trava sem IP.
[keyfile]
unmanaged-devices=interface-name:p2p0

# economia de energia do Wi-Fi causa quedas nesse chip
[connection]
wifi.powersave=2
EOS
ok "99-k36s-wifi.conf criado"
systemctl restart NetworkManager && ok "NetworkManager reiniciado"

sync
echo "$VER" > "$DONE"
echo "==== fim $(date) ===="
echo
exit 0
