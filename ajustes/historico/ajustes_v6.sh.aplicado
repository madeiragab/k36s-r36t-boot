#!/bin/bash
# Ajustes aplicados no boot (chamado pelo /boot/firstboot.sh, como root).
# Aplica, em ordem, as versoes que ainda nao rodaram. Log: /boot/ajustes_log.txt
# v1-v5 (ja aplicadas): LED, controles, hora, ES, save no power, desempenho, audio
# v6: saida de som volta para SPK (SPK_HP deixava o alto-falante baixo); volume inicial 10%
VER=6
DONE=/boot/ajustes.done
LOG=/boot/ajustes_log.txt
CUR="$(cat "$DONE" 2>/dev/null)"; CUR=${CUR:-0}
# todo boot, antes do EmulationStation abrir: volume em 10% (evita o barulho alto ao ligar)
amixer -q sset 'Playback' 10% 2>/dev/null
[ "$CUR" -ge "$VER" ] && exit 0

BK=/opt/ajustes-backup/$(date +%Y%m%d-%H%M%S)
mkdir -p "$BK"
exec >>"$LOG" 2>&1
echo "==== ajustes v$((CUR+1))..v$VER  $(date)  console=$(cat /boot/.console 2>/dev/null) ===="
bk()   { [ -e "$1" ] && mkdir -p "$BK$(dirname "$1")" && cp -a "$1" "$BK$1" && echo "  backup: $1"; }
ok()   { echo "OK   $*"; }

echo "[1] audio-fix.sh: saida SPK (alto-falante com ganho normal), volume inicial 10%"
F=/usr/local/bin/audio-fix.sh
bk "$F"
cat > "$F" <<'EOS'
#!/bin/bash
# Reinicia o codec RK817 (R36S V5) e deixa o audio num estado conhecido.
# Roda no boot pelo audio-resume.service.
sleep 5
# suspende 1 s e acorda: reseta fisicamente o RK817
rtcwake -m mem -s 1
sleep 2
# saida no alto-falante, som ligado; volume comeca em 10% (sobe normal pelos botoes)
amixer -q sset 'Playback Path' SPK
amixer -q sset 'Playback' 10% unmute 2>/dev/null || amixer -q sset 'Playback' 10%
alsactl store
iw dev wlan0 set power_save off
exit 0
EOS
chmod 755 "$F"
bash -n "$F" && ok "audio-fix.sh: SPK + volume inicial 10%"
# aplica agora tambem, sem esperar o audio-fix rodar
amixer -q sset 'Playback Path' SPK && ok "Playback Path = $(amixer sget 'Playback Path' | grep -o "Item0: '[^']*'")"

sync
echo "$VER" > "$DONE"
echo "==== fim $(date) ===="
echo
exit 0
